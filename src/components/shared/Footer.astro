---
import { FaArrowUp } from "react-icons/fa";
---

<footer
  id="footer"
  class="p-6 w-full text-neutral-800 animate-fade animate-duration-200 animate-ease-in"
>
  <hr class="border-t border-neutral-300 my-6" />

  <div class="flex flex-col justify-center items-center gap-6">
    <div class="text-center md:text-left">
      <h2
        class="text-xl font-semibold tracking-widest text-neutral-900 uppercase mb-2"
      >
        Mapas Perfectos
      </h2>
      <p class="text-sm font-normal text-neutral-700">
        Mapas Perfectos es una plataforma para aprender como funcionan los mapas
        en la web
      </p>
    </div>

    <nav class="flex space-x-4 text-sm font-semibold text-neutral-700">
      <a
        rel="noopener noreferrer"
        target="_blank"
        href="https://github.com/CastDev-j"
        class="px-4 py-2 rounded-lg hover:text-neutral-900 hover:bg-neutral-100 focus:text-neutral-900 focus:bg-neutral-200 focus:outline-none focus:shadow-outline"
      >
        GitHub
      </a>
      <a
        rel="noopener noreferrer"
        target="_blank"
        href="https://castdev-j.netlify.app/"
        class="px-4 py-2 rounded-lg hover:text-neutral-900 hover:bg-neutral-100 focus:text-neutral-900 focus:bg-neutral-200 focus:outline-none focus:shadow-outline"
      >
        Portfolio
      </a>
      <a
        href="mailto:andres2004_cj@outlook.com"
        rel="noopener noreferrer"
        target="_blank"
        class="px-4 py-2 rounded-lg hover:text-neutral-900 hover:bg-neutral-100 focus:text-neutral-900 focus:bg-neutral-200 focus:outline-none focus:shadow-outline"
      >
        Contacto
      </a>
    </nav>

    <a
      href="#header"
      class="flex items-center space-x-2 px-4 py-2 rounded-lg text-neutral-700 hover:text-neutral-900 hover:bg-neutral-100 focus:text-neutral-900 focus:bg-neutral-200 focus:outline-none focus:shadow-outline"
    >
      <FaArrowUp />
      <span>Volver al inicio</span>
    </a>
  </div>
</footer>
